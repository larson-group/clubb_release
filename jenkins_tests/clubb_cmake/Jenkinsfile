// Build GNU, Intel and NVHPC variants and run each variant's CTests.
// From the repository root on a UWM worker, source /etc/profile.d/larson-group.sh
// and load the compiler plus netcdf-fortran; for example: ./compile.py -debug -openmp -run_tests.
// Record independent failures while allowing manual aborts to stop the pipeline.
pipeline {

  agent any
  options { disableConcurrentBuilds() }

  stages {
    // Parallel checks use separate workspaces and checkouts on the selected worker.
    stage('Independent workflows') {
      parallel {
        stage('Compile gfortran') {
          steps {
            ws("${env.WORKSPACE}@compile_gfortran") {
              checkout scm

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load gcc netcdf-fortran
                  ./compile.py -run_tests
                '''
              }
            }
          }
        }
        stage('Compile gfortran: openmp+debug') {
          steps {
            ws("${env.WORKSPACE}@compile_gfortran_openmp_debug") {
              checkout scm

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load gcc netcdf-fortran
                  ./compile.py -debug -openmp -run_tests
                '''
              }
            }
          }
        }
        stage('Compile ifx') {
          steps {
            ws("${env.WORKSPACE}@compile_ifx") {
              checkout scm

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load intel netcdf-fortran
                  ./compile.py -run_tests
                '''
              }
            }
          }
        }
        stage('Compile ifx: single precision') {
          steps {
            ws("${env.WORKSPACE}@compile_ifx_single_precision") {
              checkout scm

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load intel netcdf-fortran
                  ./compile.py -precision single -run_tests
                '''
              }
            }
          }
        }
        stage('Compile nvfortran') {
          steps {
            ws("${env.WORKSPACE}@compile_nvfortran") {
              checkout scm

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load nvhpc netcdf-fortran
                  ./compile.py -run_tests
                '''
              }
            }
          }
        }
        stage('Compile nvfortran: openacc') {

          // CTest must also run GPU executables one at a time.
          environment { CTEST_PARALLEL_LEVEL = '1' }
          steps {
            ws("${env.WORKSPACE}@compile_nvfortran_openacc") {
              checkout scm

              // Serialize GPU cases on this worker; other nodes may run concurrently.
              lock("GPU_${env.NODE_NAME}") {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                  sh '''
                    source /etc/profile.d/larson-group.sh
                    module load nvhpc netcdf-fortran
                    ./compile.py -gpu openacc -run_tests
                  '''
                }
              }
            }
          }
        }
      }
    }
  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_cmake" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
