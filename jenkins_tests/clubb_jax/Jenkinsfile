// Record independent failures while allowing manual aborts to stop the pipeline.
pipeline {
  // Keep memory-heavy CPU JAX case workers on Carson; stages remain sequential.
  agent { label 'carson' }
  environment { CLUBB_JAX_ACCELERATOR = 'cpu' }
  stages {
    stage('Compile') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load gcc netcdf-fortran
          # The Python API build also provides the Fortran reference for the JAX F2PY unit tests.
          ./compile.py -debug -python
        '''
      }
    }
    stage('Run JAX pytests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            bash tests/run_pytests.sh -jax -include_generated -v --durations=15 \
              --junitxml="$WORKSPACE/output/tests/pytests/jax.xml"
          '''
        }
      }
    }
    stage('JAX F2PY unit tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            bash tests/run_pytests.sh -jax_f2py_unit_tests -include_generated -v --durations=15 \
              --junitxml="$WORKSPACE/output/tests/pytests/jax_f2py_unit_tests.xml"
          '''
        }
      }
    }
    stage('Expected failure test') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            python3 tests/run_jax_comparison_mutation_test.py
          '''
        }
      }
    }
    stage('Jax vs Fortran: standard stats') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            ./tests/run_jax_vs_fortran_cases.py -workers 8
          '''
        }
      }
    }
    stage('Run Jax Python vs Fortran cases w varying flags') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            python3 tests/run_jax_vs_fortran_cases.py -debug 0 -max_iters 5 -workers 8 -flag_config_file input/flag_sets/config_core_flags_wo_never_supported_jax_features.json
          ''' // Bound the varying-flag sweep to five timesteps per case.
        }
      }
    }
  }
  post {
    always {
      junit testResults: 'output/tests/pytests/*.xml', allowEmptyResults: true
    }
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_jax" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
