// Record independent failures while allowing manual aborts to stop the pipeline.
pipeline {
  // Keep memory-heavy CPU JAX case workers on Carson; stages remain sequential.
  agent { label 'carson' }
  environment { CLUBB_JAX_ACCELERATOR = 'cpu' }
  stages {
    stage('Compile') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load gcc netcdf-fortran
          # The Python API build also provides the Fortran reference for the JAX F2PY unit tests.
          ./compile.py -debug -python
        '''
      }
    }
    stage('Fortran declaration match') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            # Fails when a JAX docstring no longer carries the argument declarations
            # of its Fortran routine; fix with -write_declaration (see the script's README).
            python3 utilities/port_fortran_declarations_to_jax_docstrings/port_fortran_declarations_to_jax_docstrings.py -check
          '''
        }
      }
    }
    stage('File-name parity') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            # Human-reviewed check that clubb_jax/src mirrors src/ file for file.
            # The test itself uses only the standard library; the JAX environment
            # is prepared only because it provides pytest.
            python3 clubb_jax/run_jax.py -profile=cpu -init_env
            .venv-jax/bin/python -m pytest -v clubb_jax/human_reviewed_tests/test_file_name_parity.py \
              --junitxml="$WORKSPACE/output/tests/pytests/jax_file_name_parity.xml"
          '''
        }
      }
    }
    stage('JAX vs Fortran hole filling') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            # Human-reviewed check of the hole fillers against Fortran through the Python API build.
            bash human_reviewed_tests/run_pytests.sh -jax_f2py_human_reviewed -v \
              --junitxml="$WORKSPACE/output/tests/pytests/jax_fill_holes_vs_fortran.xml"
          '''
        }
      }
    }
    // Auto-LLM-generated pytests; comment out a stage to skip that suite.
    stage('Auto-LLM-generated JAX pytests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            bash human_reviewed_tests/run_pytests.sh -jax -v --durations=15 \
              --junitxml="$WORKSPACE/output/tests/pytests/jax.xml"
          '''
        }
      }
    }
    stage('Auto-LLM-generated JAX F2PY unit tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            bash human_reviewed_tests/run_pytests.sh -jax_f2py_unit_tests -v --durations=15 \
              --junitxml="$WORKSPACE/output/tests/pytests/jax_f2py_unit_tests.xml"
          '''
        }
      }
    }
    stage('Expected failure test') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            python3 human_reviewed_tests/run_jax_comparison_mutation_test.py
          '''
        }
      }
    }
    stage('Jax vs Fortran: standard stats') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            ./human_reviewed_tests/run_jax_vs_fortran_cases.py -workers 8
          '''
        }
      }
    }
    stage('Run Jax Python vs Fortran cases w varying flags') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            human_reviewed_tests/run_jax_vs_fortran_cases.py -debug 0 -cases cobra, bomex -flag_config_file input/flag_sets/config_core_flags_wo_never_supported_jax_features.json -skip_default_flags -stats multi_col_stats
          ''' // Full curated durations. The standard stats stage already runs the default flags; multi_col_stats compares 15 core fields instead of 623.
        }
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            human_reviewed_tests/run_jax_vs_fortran_cases.py -debug 0 -cases dycoms2_rf02_ds -max_iters 140 -flag_config_file input/flag_sets/config_core_flags_wo_never_supported_jax_features.json -skip_default_flags -stats multi_col_stats
          ''' // Under flag10 and flag14, roundoff growth exceeds 1e-7 after about 150 steps, as it does between the -O0 and -O2 Fortran builds, so stop at 140 instead of 230.
        }
      }
    }
  }
  post {
    always {
      junit testResults: 'output/tests/pytests/*.xml', allowEmptyResults: true
    }
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_jax" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
