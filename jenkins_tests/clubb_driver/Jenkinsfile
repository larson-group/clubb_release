// Check complete-case process reuse first, then the existing reusable-model drivers.
// The first stage requires stable worker PIDs and exact numeric NetCDF statistics
// versus fresh processes for Fortran, Python and CPU JAX. Native/JAX change cases
// BOMEX -> RICO_SILHS -> BOMEX; Python changes column counts using BOMEX only.
// Run the three case-runner checks sequentially on any available worker.
//
// Later stages compare standalone and reset/rerun outputs: JAX BOMEX/ATEX with
// four parameter sets in batches of two (eight steps), Intel standard cases with
// four columns (at most 500 steps), and NVIDIA OpenACC minimal cases with eight
// columns (at most 200 steps). GPU SILHS uses straight Monte Carlo in both runs.
//
// Reproduce the first stage from the repository root on a UWM worker:
//   source /etc/profile.d/larson-group.sh
//   module load gcc netcdf-fortran
//   ./compile.py -debug -python
//   ulimit -s 8388608
//   python3 tests/case_runner_lifecycle_test.py -output_dir output/driver_test/case_runner_native
//   python3 tests/case_runner_lifecycle_test.py -python -output_dir output/driver_test/case_runner_python
//   python3 tests/case_runner_lifecycle_test.py -jax=cpu -output_dir output/driver_test/case_runner_jax
// Elsewhere, provide the GNU/NetCDF build environment described in BUILD.md.
// Python dependencies and the JAX CPU environment use the existing bootstraps.
// Record independent failures while allowing manual aborts to stop the pipeline.
pipeline {

  agent none
  options { disableConcurrentBuilds() }

  stages {
    stage('Case runner lifecycle') {
      agent any
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ./compile.py -debug -python
            ulimit -s 8388608
            python3 tests/case_runner_lifecycle_test.py -output_dir output/driver_test/case_runner_native
          '''
        }
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            source /etc/profile.d/larson-group.sh
            module load gcc netcdf-fortran
            ulimit -s 8388608
            python3 tests/case_runner_lifecycle_test.py -python -output_dir output/driver_test/case_runner_python
          '''
        }
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            python3 tests/case_runner_lifecycle_test.py -jax=cpu -output_dir output/driver_test/case_runner_jax
          '''
        }
      }
      post {
        unsuccessful {
          archiveArtifacts artifacts: 'output/driver_test/case_runner_*/**', allowEmptyArchive: true
        }
      }
    }
    // Each branch owns its executor, checkout, build, and output files.
    stage('Independent workflows') {
      parallel {
        stage('JAX reusable driver lifecycle') {
          agent { label 'carson' }
          steps {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
              sh '''
                # Compare the same namelists through the normal and reset/rerun frontends.
                run_scripts/run_scm_all.py -jax -cases bomex,atex -workers 1 \
                  -multicol C8/0.2:0.8/4 -batch_size 2 -max_iters 8 \
                  -dt_main 60 -dt_rad 60 -tout 60 -override 'stats_tsamp=60.' \
                  -output_dir driver_test/standalone_jax
                run_scripts/run_scm_all.py -jax -driver_test -cases bomex,atex -workers 1 \
                  -multicol C8/0.2:0.8/4 -batch_size 2 -max_iters 8 \
                  -dt_main 60 -dt_rad 60 -tout 60 -override 'stats_tsamp=60.' \
                  -output_dir driver_test/driver_jax
                run_scripts/run_bindiff_all.py output/driver_test/standalone_jax \
                  output/driver_test/driver_jax -strict
              '''
            }
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
              sh '''
                # JAX-only assertions beyond src/clubb_driver_test.F90.
                python3 clubb_jax/tests/run_driver_extensions_test.py
              '''
            }
          }
        }
        stage('standard cases + multi_col with ifx') {
          agent any
          steps {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
              sh '''
                source /etc/profile.d/larson-group.sh
                module load intel netcdf-fortran
                ./compile.py
                ulimit -s 8388608
                run_scripts/run_scm_all.py -workers 4 -multicol 4 -max_iters 500 -output_dir driver_test/standalone_ifx
                run_scripts/run_scm_all.py -workers 4 -multicol 4 -max_iters 500 -output_dir driver_test/driver_ifx -driver_test
                run_scripts/run_bindiff_all.py output/driver_test/standalone_ifx output/driver_test/driver_ifx
              '''
            }
          }
        }
        stage('min_cases + multi_col with nvhpc + openacc') {
          agent any
          steps {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
              sh '''
                source /etc/profile.d/larson-group.sh
                module load nvhpc netcdf-fortran
                ./compile.py -gpu openacc
              '''
              // Serialize GPU cases on this worker; other nodes may run concurrently.
              lock( "GPU_${env.NODE_NAME}" ) {
                sh '''
                  # Allow the large Fortran automatic arrays used by these cases.
                  ulimit -s 8388608
                  run_scripts/run_scm_all.py -workers 1 -min_cases -multicol 8 -max_iters 200 -output_dir driver_test/standalone_nvhpc -override l_lh_straight_mc=.true.
                  run_scripts/run_scm_all.py -workers 1 -min_cases -multicol 8 -max_iters 200 -output_dir driver_test/driver_nvhpc -driver_test -override l_lh_straight_mc=.true.
                '''
              }
              sh '''run_scripts/run_bindiff_all.py output/driver_test/standalone_nvhpc output/driver_test/driver_nvhpc'''
            }
          }
        }
      }
    }
  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_driver" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
