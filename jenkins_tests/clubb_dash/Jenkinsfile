// Run the auto-LLM-generated Dash pytest suite.
pipeline {
  agent any
  stages {
    stage('Auto-LLM-generated Dash pytests') {
      steps {
        sh '''
          # Use the Node runtime provisioned once for the Jenkins account on each worker.
          export PATH="$HOME/.local/bin:$PATH"
          node --version
          bash human_reviewed_tests/run_pytests.sh -dash \
            --junitxml="$WORKSPACE/output/tests/pytests/dash.xml" --durations=10
        '''
      }
    }
  }
  post {
    always {
      junit testResults: 'output/tests/pytests/*.xml', allowEmptyResults: true
    }
  }
}
