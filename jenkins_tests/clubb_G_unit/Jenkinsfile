// Run standard and reverse-grid G-unit checks with a GNU debug build.
// From the repository root, load gcc/netcdf-fortran, run python compile.py -debug,
// then python human_reviewed_tests/run_G_unit_tests.py (add -rev_direction_grid_test for reversal).
// Record independent failures while allowing manual aborts to stop the pipeline.
pipeline {
  agent any
  options { disableConcurrentBuilds() }

  stages {
    // Parallel checks use separate workspaces and checkouts on the selected worker.
    stage('Independent workflows') {
      parallel {
        stage('Run standard G-unit tests') {
          steps {
            ws("${env.WORKSPACE}@run_standard_g_unit_tests") {
              checkout scm

              sh '''
                source /etc/profile.d/larson-group.sh
                module load gcc netcdf-fortran
                python compile.py -debug
              '''

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load gcc netcdf-fortran
                  python human_reviewed_tests/run_G_unit_tests.py
                '''
              }
            }
          }
        }
        stage('Run reverse-grid G-unit test') {
          steps {
            ws("${env.WORKSPACE}@run_reverse_grid_g_unit_test") {
              checkout scm

              sh '''
                source /etc/profile.d/larson-group.sh
                module load gcc netcdf-fortran
                python compile.py -debug
              '''

              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                sh '''
                  source /etc/profile.d/larson-group.sh
                  module load gcc netcdf-fortran
                  python human_reviewed_tests/run_G_unit_tests.py -rev_direction_grid_test
                '''
              }
            }
          }
        }
      }
    }
  }
  post {
    failure {
      script {

        // Only the production job sends failure mail.

        if (env.JOB_NAME == 'clubb_G_unit') {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
