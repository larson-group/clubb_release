// GPU SILHS requires straight Monte Carlo sampling in both comparison runs.
// Compare synchronous and async OpenACC outputs exactly using a 16-column C8 hypergrid.
pipeline {

  agent any

  stages {
    stage('Compile Normal GPU') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load nvhpc netcdf-fortran
          ./compile.py -gpu openacc
        '''
      }
    }
    stage('Run Normal GPU') {
      steps {
        // Serialize GPU cases on this worker; other nodes may run concurrently.
        lock( "GPU_${env.NODE_NAME}" ) {
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/normal arm
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/normal atex
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/normal bomex
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/normal -override l_lh_straight_mc=true rico_silhs
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/normal -override l_lh_straight_mc=true mpace_b_silhs
          '''
        }
      }
    }
    stage('Convert To Async') {
      steps {
        sh '''python3 utilities/convert_to_async.py'''
      }
    }
    stage('Compile Async GPU') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load nvhpc netcdf-fortran
          ./compile.py -gpu openacc
        '''
      }
    }
    stage('Run Async GPU') {
      steps {
        // Serialize GPU cases on this worker; other nodes may run concurrently.
        lock( "GPU_${env.NODE_NAME}" ) {
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/async arm
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/async atex
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/async bomex
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/async -override l_lh_straight_mc=true rico_silhs
            run_scripts/run_scm.py -multicol C8/0.4:0.9/16 -stats input/stats/multi_col_stats.in -debug 0 -out_dir gpu_async/async -override l_lh_straight_mc=true mpace_b_silhs
          '''
        }
      }
    }
    stage('Compare Outputs') {
      steps {
        sh '''run_scripts/run_bindiff_all.py output/gpu_async/normal output/gpu_async/async -v 2'''
      }
    }
  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_gpu_async_output_matching" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
