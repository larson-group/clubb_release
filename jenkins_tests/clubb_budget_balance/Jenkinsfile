// Check budget validation and case-runner behavior with focused pytests, then
// run the SCM cases and verify their budgets.
// From the repository root, with GCC and NetCDF Fortran modules available:
//   ./compile.py
//   bash human_reviewed_tests/run_pytests.sh -unit -k 'budget_balance or budget_runner' -q
//   python3 human_reviewed_tests/check_budget_balance.py .
// The focused tests are auto-LLM-generated and use temporary NetCDF files.
pipeline {
  agent any
  stages {
    stage('Compile') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load gcc netcdf-fortran
          ./compile.py
        '''
      }
    }
    stage('Run budget pytests') {
      steps {
        sh '''bash human_reviewed_tests/run_pytests.sh -unit -k 'budget_balance or budget_runner' -q'''
      }
    }
    stage('Run check_budget_balance') {
      steps {
        sh '''python3 human_reviewed_tests/check_budget_balance.py .'''
      }
    }
  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" ==	"clubb_budget_balance" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
