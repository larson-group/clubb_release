// Check loss drivers, scalar tuning, saved history and CPU JAX tuning from the repo root.
// GNU Fortran and NetCDF-Fortran must be available through the Larson module environment;
// compile.py -debug -python supplies the native/Python loss API. JAX sets up its own CPU env.
// Reproduce scalar coverage with the case/strategy commands in each stage below.
// Run the fast tuner checks first, without a Fortran build:
//   bash human_reviewed_tests/run_pytests.sh -unit -k tuner
// Reproduce the independent gradient/first-update/history checks with:
//   python3 tuner/auto_llm_generated_tests/integration_tests/run_adam_gradient_test.py \
//     -output_dir output/tests/adam_gradient -gradient_mode forward -batch_size 2
// That check uses BOMEX/ATEX for ten 60 s steps, wp2/thlm and two windows per case.
// It verifies real objective derivatives against centered differences and requires the
// retained best loss to be <= the first chain's starting loss, without a percentage target.
// CPU workers stay serialized; forward mode avoids the larger two-case reverse tape.
// Independent stages record failures while manual aborts stop the pipeline.
pipeline {
  agent any
  stages {
    stage('Tuner unit tests') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            bash human_reviewed_tests/run_pytests.sh -unit -k tuner \
              --junitxml=output/tests/pytests/tuner.xml --durations=10
          '''
        }
      }
      post {
        always {
          // Publish the unit-test report before running the model checks.
          junit testResults: 'output/tests/pytests/tuner.xml', allowEmptyResults: true
        }
      }
    }
    stage('Compile') {
      steps {
        sh '''
          source /etc/profile.d/larson-group.sh
          module load gcc netcdf-fortran
          ./compile.py -debug -python
        '''
      }
    }
    stage('Loss Driver Test') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''python human_reviewed_tests/run_loss_metrics_test.py'''
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            python run_scripts/run_scm_loss.py \
              -driver_test \
              -output_dir output/new_tuner_test/loss_driver_fortran \
              -cases bomex \
              -fields cloud_frac,rcm
          '''
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            python run_scripts/run_scm_loss.py \
              -python \
              -driver_test \
              -output_dir output/new_tuner_test/loss_driver_python \
              -cases bomex \
              -fields cloud_frac,rcm
          '''
        }
      }
    }
    stage('Simple Tuner Command') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            python run_scripts/run_tuner_job.py \
              -cases bomex \
              -fields cloud_frac \
              -param_ranges C8:0.2:0.8 \
              -workers 4 \
              -output_root output/tuner/new_tuner_test/simple \
              -run_top complete \
              -output_run_dir output/new_tuner_test/simple
          '''
          script { env.SIMPLE_TUNER_READY = 'true' }
        }
      }
    }
    stage('Complex Tuner Command') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            # Allow the large Fortran automatic arrays used by these cases.
            ulimit -s 8388608
            python run_scripts/run_tuner_job.py \
              -cases arm:68400:72000:3600 bomex:7200:18000:2700 \
              -fields cloud_frac rcm \
              -param_ranges C8:0.2:0.8 C11:0.1:1.0 \
              -strategy resolve:0.9 \
              -batch_size 4 \
              -workers 2 \
              -seed 1 \
              -loss_weights '{"mean":1,"std":1,"corr":1}' \
              -aggregation_mode mean_max \
              -poll_interval 1 \
              -output_root output/tuner/new_tuner_test/complex \
              -run_top both \
              -top_n 1 \
              -output_run_dir output/new_tuner_test/complex
          '''
          script { env.COMPLEX_TUNER_READY = 'true' }
        }
      }
    }
    stage('Sample History Analyzer') {
      when { expression { env.SIMPLE_TUNER_READY == 'true' && env.COMPLEX_TUNER_READY == 'true' } }
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            python human_reviewed_tests/analyze_tuner_sample_history.py \
              output/tuner/new_tuner_test \
              -metric rmse \
              -min_samples 2 \
              -require_param_variation
          '''
        }
      }
    }
    stage('JAX tuner command') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            # Keep CPU model workers serialized in this bounded tuner regression.
            python3 run_scripts/run_tuner_job.py -jax -cases bomex \
              -fields cloud_frac wp2 -param_ranges C8:0.2:0.8 \
              -strategy random:16 -batch_size 2 -workers 1 -seed 7 \
              -output_root output/tuner/jax_regression -run_top never
          '''
        }
      }
    }

    stage('JAX gradient Adam') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
          sh '''
            python3 tuner/auto_llm_generated_tests/integration_tests/run_adam_gradient_test.py \
              -output_dir output/tests/adam_gradient -gradient_mode forward -batch_size 2
          '''
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'output/tests/adam_gradient/summary.json,output/tests/adam_gradient/tuner.log',
                           allowEmptyArchive: true
        }
      }
    }

  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_tuner" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
