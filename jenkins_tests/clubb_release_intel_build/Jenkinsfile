// Build the public CLUBB release with Intel and run its standard case list.
// Run from a clean workspace with Git, Python and Carson's Intel/NetCDF modules.
// Reproduce the checkout, build and run from the workspace root:
//   git clone https://github.com/larson-group/clubb_release.git
//   source /etc/profile.d/larson-group.sh
//   module load intel netcdf-fortran
//   clubb_release/compile.py
//   clubb_release/run_scripts/run_scm.py -cases standard_cases
// Passing confirms compilation and case completion; outputs are not compared.

pipeline {
  agent any
  stages {
    stage('Checkout Clubb_Release') {
      steps {
        sh '''git clone https://github.com/larson-group/clubb_release.git'''
      }
    }
    stage('Compile Clubb Release ') {
      steps {
        // Load the compiler and matching NetCDF runtime from the shared module setup.
        sh '''
          source /etc/profile.d/larson-group.sh
          module load intel netcdf-fortran
          clubb_release/compile.py
        '''
      }
    }
    stage('Run') {
      steps {
        // Select the release catalog's standard cases explicitly.
        sh '''clubb_release/run_scripts/run_scm.py -cases standard_cases'''
      }
    }
  }
  post {
    failure {
      script {
        // Only the production job sends failure mail.
        if ( "${env.JOB_NAME}" == "clubb_release_intel_build" ) {
          emailext(to: 'messnermet@uwm.edu', subject: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has Failed", attachLog: true, body: "${env.JOB_NAME} build ${env.BUILD_NUMBER} has failed. See the attached build log and the build results (${env.BUILD_URL}) for help troubleshooting.")
        }
      }
    }
  }
}
