  "component_contracts": [
    "Six source-named sponge records bind existing four members via Nativepercent paths.",
    "Microphys slope/intercept and SILHS eight-cluster records bind existing flattened scalar formals via Nativepercent paths."
  ],
  "string_contract": "Use each declaration width; shared Group trims only trailing Native blanks on C++ writeback, no local parsing.",
  "error_contract": "Status readers return parserstatus unchanged. No-status setfields/radiation throw with shared Group.error; optional-missing multicol caller logic untouched.",
  "generation_contract": "New permanent generators reuse existing Native declaration parsers; do not call or edit old f2k generators.",
  "radiation_append": "Shared text_writer.hpp; Native24write_text calls (3headers+21settings), same order/20-entry arrays/real-kind print casts; no Fortran I/O call.",
  "excluded_edits": [
    "shared CMake",
    "callers",
    "old f2k I/O generators/sources",
    "parser implementation",
    "Native source",
    "other IO groups not currently reached by supported driver services"
  ],
  "verification": "Separate source/signature/field/kind/width/extent/order audit and generation-idempotence; Root owns final model/parser checks."
