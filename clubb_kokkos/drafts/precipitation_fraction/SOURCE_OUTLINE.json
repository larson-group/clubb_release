      "call_and_function_order": [
        "call component_precip_frac_weighted( gr, nzt, ngrdcol, hydromet_dim, l_frozen_hm, hydromet_tol, hydromet(:,:,:), precip_frac(:,:), cloud_frac_1(:,:), cloud_frac_2(:,:), ice_supersat_frac_1(:,:), ice_supersat_frac_2(:,:), mixt_frac(:,:), precip_frac_tol(:), precip_frac_1(:,:), precip_frac_2(:,:) )",
        "call component_precip_frac_specify( nzt, ngrdcol, hydromet_dim, hydromet_tol, clubb_params(:,iupsilon_precip_frac_rat), hydromet(:,:,:), precip_frac(:,:), mixt_frac(:,:), precip_frac_tol(:), precip_frac_1(:,:), precip_frac_2(:,:) )",
        "call stats_update( \"precip_frac_tol\", precip_frac_tol, stats )",
        "call precip_frac_assert_check( nzt, hydromet_dim, hydromet_tol, hydromet(j,:,:), mixt_frac(j,:), precip_frac(j,:), precip_frac_1(j,:), precip_frac_2(j,:), precip_frac_tol(j), err_info )"
      ],
      "branches_in_order": [
        "if ( any( l_frozen_hm ) ) then",
        "else",
        "if ( any( l_frozen_hm ) ) then",
        "else",
        "if ( any( hydromet(j,k,:) >= hydromet_tol(:) ) .and. precip_frac(j,k) < precip_frac_tol(j) ) then",
        "elseif ( all( hydromet(j,k,:) < hydromet_tol(:) ) ) then",
        "if ( precip_frac_calc_type == 1 ) then",
        "elseif ( precip_frac_calc_type == 2 ) then",
        "else",
        "if ( l_mix_rat_hm(ivar) ) then",
        "if ( hydromet(j,k,ivar) >= hydromet_tol(ivar) .and. hydromet(j,k,ivar) > mixt_frac(j,k) * precip_frac_1(j,k) * max_hm_ip_comp_mean ) then",
        "if ( hydromet(j,k,ivar) >= hydromet_tol(ivar) .and. hydromet(j,k,ivar) > ( one - mixt_frac(j,k) ) * precip_frac_2(j,k) * max_hm_ip_comp_mean ) then",
        "if ( any( hydromet(j,k,:) >= hydromet_tol(:) ) ) then",
        "if ( stats%l_sample ) then",
        "if ( clubb_at_least_debug_level_api( 2 ) ) then",
        "if ( err_info%err_code(j) == clubb_fatal_error ) then"
      ]
