// Forward scoring and optional reverse differentiation for one case.
digraph case_loss {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.5", fontname="DejaVu Sans", fontsize=18, label="Inside one case loss session", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#edf5fc", color="#49738f", fontname="DejaVu Sans", fontsize=13, margin="0.18,0.12"];
  edge [color="#456174", arrowsize=0.75, fontname="DejaVu Sans", fontsize=11];
  reference [label="Configured LES reference\nNormalize names and units\nInterpolate to CLUBB heights\nAverage each field/window", fillcolor="#f3f4f6", color="#78848d"];
  subgraph cluster_path {
    label="Model-to-loss numerical path\nDifferentiable when the backend is JAX";
    fontname="DejaVu Sans"; fontsize=14; color="#8f6bb0"; style=rounded;
    params [label="Candidate parameters"];
    core [label="Case driver + CLUBB core\nCore treated as a black box\nReset state; advance all timesteps", fillcolor="#183b50", color="#183b50", fontcolor=white];
    stats [label="In-memory statistics\nTime-average selected fields\nwithin each window", fillcolor="#eaf6f1", color="#47836f"];
    comparison [label="Compare paired vertical profiles\nat the selected heights\nOne per field/window/candidate", fillcolor="#eaf6f1", color="#47836f"];
    metrics [label="Four profile metrics\nRMSE; correlation r\nstd ratio s; normalized bias b", fillcolor="#eaf6f1", color="#47836f"];
    case_score [label="Field-weighted RMS\nacross fields and windows\nOne L_case per candidate", fillcolor="#fff4df", color="#ae8236"];
    params -> core;
    core -> stats [label="model fields throughout time"];
    stats -> comparison [label="averaged model profiles"];
    comparison -> metrics;
    metrics -> case_score [label="RMSE values only"];
    case_score -> params [style=dashed, color="#8252a3", constraint=false];
  }
  diagnostics [label="Retain all four metrics\nwith field + window labels", fillcolor="#f3f4f6", color="#78848d"];
  gradient [label="Optional JAX output\nDerivative of L_case with respect\nto each selected physical parameter", fillcolor="#f3edf9", color="#8252a3"];
  result [label="Return to the tuner\nCase loss + metrics + optional gradient", fillcolor="#f3f4f6", color="#78848d"];
  legend [shape=plaintext, style="", label="Purple dashed arrow: JAX reverse differentiation\nthrough all timesteps, including unscored spinup.", fontcolor="#72448f", fontsize=11];
  reference -> comparison;
  metrics -> diagnostics;
  case_score -> gradient [label="grad = true", color="#8252a3", fontcolor="#72448f"];
  case_score -> result [label="loss value"];
  diagnostics -> result;
  gradient -> result;
  result -> legend [style=invis];
}
