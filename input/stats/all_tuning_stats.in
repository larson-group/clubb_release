&clubb_stats_nl
  ! Auto-curated tuner stats: exact CLUBB stats names supported by
  ! utilities/benchmark_converter.py and present in input/stats/all_stats.in.
  ! entry(i) format: "name | grid | units | long_name"
  entry(1) = "thlm                      | zt     | K                     | Liquid water potential temperature (theta_l)"
  entry(2) = "rtm                       | zt     | kg/kg                 | Total (vapor+liquid) water mixing ratio"
  entry(3) = "rcm                       | zt     | kg/kg                 | Cloud water mixing ratio"
  entry(4) = "um                        | zt     | m/s                   | Grid-mean eastward (u) wind"
  entry(5) = "vm                        | zt     | m/s                   | Grid-mean northward (v) wind"
  entry(6) = "cloud_frac                | zt     | -                     | Cloud fraction (between 0 and 1)"
  entry(7) = "ice_supersat_frac         | zt     | count                 | Ice cloud fraction (between 0 and 1)"
  entry(8) = "wp3                       | zt     | m^3/s^3               | Third-order moment of vertical air velocity"
  entry(9) = "thlp3                     | zt     | K^3                   | Third-order moment of theta_l"
  entry(10) = "rtp3                      | zt     | (kg/kg)^3             | Third-order moment of total water, rt"
  entry(11) = "wpthlp2                   | zt     | (m K^2)/s             | Vertical turbulent flux of theta_l'^2"
  entry(12) = "wp2thlp                   | zt     | (m^2 K)/s^2           | Vertical turbulent flux of w'theta_l'"
  entry(13) = "wprtp2                    | zt     | (m kg)/(s kg)         | Vertical turbulent flux of rt'^2"
  entry(14) = "wp2rtp                    | zt     | (m^2 kg)/(s^2 kg)     | Vertical turbulent flux of w'rt'"
  entry(15) = "Skw_zt                    | zt     | -                     | Skewness of w on thermodynamic levels"
  entry(16) = "Skthl_zt                  | zt     | -                     | Skewness of thl on thermodynamic levels"
  entry(17) = "Skrt_zt                   | zt     | -                     | Skewness of rt on thermodynamic levels"
  entry(18) = "wp2thvp                   | zt     | K m^2/s^2             | Vertical turbulent flux of w'theta_v'"
  entry(19) = "w_up_in_cloud             | zt     | m/s                   | Mean W in saturated updrafts"
  entry(20) = "wprtpthlp                 | zt     | (m kg K)/(s kg)       | Vertical turbulent flux of rt'theta_l'"
  entry(21) = "wpup2                     | zt     | m^3/s^3               | Third-order moment from PDF"
  entry(22) = "wpvp2                     | zt     | m^3/s^3               | Third-order moment from PDF"
  entry(23) = "radht                     | zt     | K/s                   | Total (sw+lw) radiative heating rate"
  entry(24) = "Ncm                       | zt     | num/kg                | Cloud droplet number concentration"
  entry(25) = "Nc_in_cloud               | zt     | num/kg                | In cloud droplet concentration"
  entry(26) = "Nim                       | zt     | num/kg                | Ice crystal number concentration"
  entry(27) = "Nsm                       | zt     | num/kg                | Snow particle number concentration"
  entry(28) = "Ngm                       | zt     | num/kg                | Graupel number concentration"
  entry(29) = "rrm                       | zt     | kg/kg                 | Rain water mixing ratio"
  entry(30) = "Nrm                       | zt     | num/kg                | Rain drop number concentration"
  entry(31) = "rsm                       | zt     | kg/kg                 | Snow water mixing ratio"
  entry(32) = "rim                       | zt     | kg/kg                 | Pristine ice water mixing ratio"
  entry(33) = "rgm                       | zt     | kg/kg                 | Graupel water mixing ratio"
  entry(34) = "rrm_evap                  | zt     | kg kg^{-1} s^{-1}     | rrm evaporation rate"
  entry(35) = "rrm_auto                  | zt     | kg kg^{-1} s^{-1}     | rrm autoconversion rate"
  entry(36) = "rrm_accr                  | zt     | kg kg^{-1} s^{-1}     | rrm accretion rate"
  entry(37) = "precip_frac               | zt     | -                     | Precipitation Fraction"
  entry(38) = "wp2_zt                    | zt     | m^2/s^2               | w'^2 interpolated to thermodynamic levels"
  entry(39) = "thlp2_zt                  | zt     | K^2                   | thl'^2 interpolated to thermodynamic levels"
  entry(40) = "wpthlp_zt                 | zt     | (m K)/s               | w'thl' interpolated to thermodynamic levels"
  entry(41) = "wprtp_zt                  | zt     | (m kg)/(s kg)         | w'rt' interpolated to thermodynamic levels"
  entry(42) = "rtp2_zt                   | zt     | (kg/kg)^2             | rt'^2 interpolated to thermodynamic levels"
  entry(43) = "wp2                       | zm     | m^2/s^2               | Variance of vertical air velocity"
  entry(44) = "rtp2                      | zm     | (kg/kg)^2             | Variance of total water, rt"
  entry(45) = "thlp2                     | zm     | K^2                   | Variance of theta_l"
  entry(46) = "rtpthlp                   | zm     | (kg K)/kg             | Covariance of rt and theta_l"
  entry(47) = "wprtp                     | zm     | (m kg)/(s kg)         | Vertical turbulent flux of total water, rt"
  entry(48) = "wpthlp                    | zm     | (m K)/s               | Vertical turbulent flux of theta_l"
  entry(49) = "wp2up2                    | zm     | (m^4)/(s^4)           | 4th-order moment of vertical and zonal air velocity"
  entry(50) = "wp2vp2                    | zm     | (m^4)/(s^4)           | 4th-order moment of vert. and merid. air velocity"
  entry(51) = "wp4                       | zm     | (m^4)/(s^4)           | Fourth-order moment of vertical air velocity"
  entry(52) = "up2                       | zm     | m^2/s^2               | Variance of eastward (u) wind"
  entry(53) = "vp2                       | zm     | m^2/s^2               | Variance of northward (v) wind"
  entry(54) = "wpthvp                    | zm     | K m/s                 | Buoyancy flux"
  entry(55) = "rtpthvp                   | zm     | (kg/kg) K             | Covariance of rt and theta_v"
  entry(56) = "thlpthvp                  | zm     | K^2                   | Covariance of theta_l and theta_v"
  entry(57) = "Kh_zm                     | zm     | m^2/s                 | Eddy diffusivity on momentum levels"
  entry(58) = "rcp2                      | zm     | (kg^2)/(kg^2)         | Variance of cloud water mixing ratio"
  entry(59) = "upwp                      | zm     | m^2/s^2               | Vertical turbulent flux of eastward (u) wind"
  entry(60) = "vpwp                      | zm     | m^2/s^2               | Vertical turbulent flux of northward (v) wind"
  entry(61) = "C6rt_Skw_fnc              | zm     | -                     | C_6rt parameter with Sk_w applied"
  entry(62) = "C6thl_Skw_fnc             | zm     | -                     | C_6thl parameter with Sk_w applied"
  entry(63) = "C6_term                   | zm     | -                     | C6 term [-]"
  entry(64) = "C7_Skw_fnc                | zm     | -                     | C_7 parameter with Sk_w applied"
  entry(65) = "C1_Skw_fnc                | zm     | -                     | C_1 parameter with Sk_w applied"
  entry(66) = "em                        | zm     | m^2/s^2               | Turbulent kinetic energy, usu. 0.5*(u'^2+v'^2+w'^2)"
  entry(67) = "bv_freq_sqd               | zm     | 1/s^2                 | Brunt-Vaisala frequency squared"
  entry(68) = "bv_freq_sqd_smth          | zm     | 1/s^2                 | Smoothed Brunt-Vaisala freq. squared"
  entry(69) = "invrs_tau_zm              | zm     | s^-1                  | invrs tau on momentum levels [s-1]"
  entry(70) = "invrs_tau_xp2_zm          | zm     | s^-1                  | invrs tau xp2 on momentum levels [s-1]"
  entry(71) = "invrs_tau_wp2_zm          | zm     | s^-1                  | invrs tau wp2 on momentum levels [s-1]"
  entry(72) = "invrs_tau_wpxp_zm         | zm     | s^-1                  | invrs tau wpxp on momentum levels [s-1]"
  entry(73) = "invrs_tau_wp3_zm          | zm     | s^-1                  | invrs tau wp3 on momentum levels [s-1]"
  entry(74) = "invrs_tau_no_N2_zm        | zm     | s^-1                  | invrs tau_no_N2 on momentum levels [s-1]"
  entry(75) = "Ri_zm                     | zm     | -                     | Richardson number [-]"
/
