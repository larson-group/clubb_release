    //================================= cobra =================================
    "cobra": {                                  // the COBRA CO2 case.
      // Howland observation tower
      // The initial data is from the upwind flights,
      // which took place at ~1600 GMT (1200 EDT).
      // The downwind flights took place at ~2100 GMT (1700 EDT).
      "model_setting": {
        "runtype": "cobra",
        "day": 11,
        "month": 6,
        "year": 2004,
        "lat_vals": 45.20407,
        "lon_vals": -68.7402,
        "time_initial": 57600.0,                // Upwind flights: 1600 GMT (1200 EDT).
        "time_final": 230400.0,                 // 48-hour run; alternative end time 75600 s corresponds to downwind flights at 2100 GMT.
        "nzmax": 100,
        "deltaz_nl": 40.0,
        "zm_top_nl": 4000.0,
        "p_sfc_nl": 97750.0,
        "fcor_nl": 0.00010349,
        "restart_path_case": "restart/cobra",
        "sclr_dim": 2,
        "iisclr_co2": 1,                        // Location in the array to place CO2
        "iisclr_rt": 2,
        "edsclr_dim": 3,
        "iiedsclr_co2": 1,                      // Location in the edsclrm array to place CO2
        "iiedsclr_rt": 2,
        "sfctype": 0,
        "iisclr_thl": -1,
        "iiedsclr_thl": 3,
        "l_t_dependent": true
      },
      "stats_setting": {
        "fname_prefix": "cobra"
      }
    },

    //================================= coriolis_test =================================
    "coriolis_test": {                          // Coriolis test case; Hing Ong, 8 August 2025
      // The "coriolis_test" is a benchmark against analytic solutions where up2, wp2, and upwp
      // interact as a harmonic oscillator analogous to the Foucault pendulum.
      // Here are the solutions to test the implementation of the nontraditional Coriolis terms:
      // upwp = amplitude(grdcol,zm) * sin( 2 * fcor_y * time )
      // ( up2 - wp2 ) / 2 = amplitude(grdcol,zm) * cos( 2 * fcor_y * time )
      // The amplitude is 2 * w_tol_sqd * sin( pi * zm / domain_depth ), maximizing at
      // 2 * w_tol_sqd at the middle vertical level.
      //
      // Before running this case,
      // set "thl_tol = zero" and "rt_tol = zero" in "src/CLUBB_core/constants_clubb.F90" and
      // set "l_ho_nontrad_coriolis": true in a flag override for input/clubb_config_flags.jsonc
      // and then compile.
      //
      // If there is a need to modify the initial conditions, search for "coriolis_test" in
      // "src/clubb_driver.F90", change, and then compile.
      "model_setting": {
        "runtype": "coriolis_test",
        "day": 1,
        "month": 1,
        "year": 1,
        "lat_vals": 0.0,
        "lon_vals": 0.0,
        "time_initial": 0.0,
        "time_final": 86400.0,
        "nzmax": 75,
        "zm_top_nl": 10000.0,
        "l_ignore_forcings": true,
        "l_input_xpwp_sfc": true,               // Flag used to determine whether or not to
                                                // read in the surface momentum fluxes,
                                                // upwp_sfc and vpwp_sfc
        "l_uv_nudge": true,
        "ts_nudge": 60.0,
        "p_sfc_nl": 100000.0,
        "restart_path_case": "restart/coriolis_test",
        "sfctype": 0,
        "l_t_dependent": true
      },
      "stats_setting": {
        "fname_prefix": "coriolis_test"
      },
      "setfields": {
        "datafile": "",
        "input_type": "clubb"
      }
    },

