        "sfctype": 0,
        "l_t_dependent": true
      },
      "microphysics_setting": {
        "microphys_scheme": "morrison",
        "l_ice_microphys": true,
        "microphys_start_time": 64800.0,
        "hmp2_ip_on_hmm2_ip_intrcpt": {"rr": 1.0, "nr": 1.0, "ri": 1.0, "ni": 1.0, "rs": 1.0, "ns": 1.0, "rg": 1.0, "ng": 1.0},
        "hmp2_ip_on_hmm2_ip_slope": {"ri": 0.0, "ni": 0.0, "rs": 0.0, "ns": 0.0, "rg": 0.0, "ng": 0.0}
      },
      "radiation_setting": {
        "rad_scheme": "simplified",
        "f0": 104.0,
        "f1": 62.0,
        "kappa": 94.2,
        "cos_solar_zen_values": 0.4329,         // The Nov.11 case uses a constant value for the cosine of the solar
                                                // zenith angle.  Because the simulation is only 4 hours long, and it
                                                // starts at 18Z (11am local time), we have rather constant sunlight
                                                // through the entire simulation period.  As a result, we will use a
                                                // constant value of xi_abs = 0.4329.  Adam Smith
                                                // Cosine of the solar zenith angle	[-]
        "fs_values": 1212.75,                   // Incoming shortwave insolation at cloud top along the beam [W/m^2].
        "l_fix_cos_solar_zen": true,
        "l_sw_radiation": true,
        "l_calc_thlp2_rad": true,
        "alvdr": 0.1
      },
      "stats_setting": {
        "fname_prefix": "nov11_altocu"
      }
    },

