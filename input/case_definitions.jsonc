{
  // Named simulation cases for CLUBB.
  //
  // "defaults" holds the shared starting settings. Each entry under "presets"
  // describes one experiment and supplies its own details and overrides. The run
  // scripts and Dash combine these settings into the model's input.
  //
  // Run a named case from the repository root, for example:
  //   python3 run_scripts/run_scm.py -cases bomex
  // A matching -config preset is applied before the selected case. Explicit run
  // overrides are applied last.
  //
  // To add a case, copy a similar preset, give it a new name, and update its
  // experiment setup and input files. Keep its location, simulation period and
  // other experiment-specific details with the case. Let shared settings inherit
  // from "defaults", and explain scientific choices beside the relevant values.
  //
  // Keep optional processes disabled in "defaults", with their parameters ready
  // for cases that enable them. Choose common parameter values among cases using
  // each feature to reduce repetition; they need not match Fortran's internal
  // defaults. Keep exceptions explicit in the cases that need them.
  //
  // Changing a default affects every case that inherits it. Before changing one
  // or moving repeated values here, check the cases that use the feature and
  // preserve their intended configurations.
  //
  // Nested groups combine, but lists replace the whole inherited list. Use
  // explicit values for exceptions; omitted settings inherit and null values
  // are rejected. See input/README.md for input formats and examples.

  //================================= DEFAULTS =================================
  "defaults": {
    "model_setting": {

      "dt_main": 60.0,                          // Model timestep [s]
      "dt_rad": 60.0,                           // Radiation timestep [s]

      "debug_level": 2,                         // Select debug level:
                                                //    0 => Print no debug messages to the screen
                                                //    1 => Print lightweight debug messages, e.g. print statements
                                                //    2 => Print debug messages that require extra testing,
                                                //         e.g. checks for NaNs and spurious negative values.

      //================================= Grid Settings =================================
      "deltaz_nl": 50.0,                        // Distance between grid levels on evenly-spaced grid.      [m]
                                                // Note:  For this option, both zt_grid_fname and zm_grid_fname must be ''.

      "grid_type": 1,                           // Select grid type:
                                                //    1 ==> evenly-spaced grid levels.
                                                //    2 ==> stretched (unevenly-spaced) grid entered on thermodynamic grid levels;
                                                //          momentum levels halfway between thermo. levels (style of SAM stretched grid).
                                                //    3 ==> stretched (unevenly-spaced) grid entered on momentum grid levels;
                                                //          thermo. levels halfway between mom. levels (style of WRF stretched grid).

      "nzmax": 128,                             // Number of vertical levels.
                                                // For grid_type = 1 nzmax can be any number

      "zm_init_nl":   0.0,                      // Minimum Altitude of lowest momentum level on any grid. [m]
      "zm_top_nl": 6950.0,                      // Maximum Altitude of highest momentum level on any grid. [m]

      "zt_grid_fname": "",                      // Stretched grid on thermodynamic levels (grid_type = 2).
                                                // Path (from ../run_scripts/) and filename of data file that contains
                                                // thermodynamic level altitudes (in meters).
                                                // Note:  For this option, zm_grid_fname must be ''.

      "zm_grid_fname": "",                      // Stretched grid on momentum levels (grid_type = 3).
                                                // Path (from ../run_scripts/) and filename to data file that contains
                                                // momentum level altitudes (in meters).
                                                // Note:  For this option, zt_grid_fname must be ''.

      //================================= Surface Settings =================================
      "sfc_elevation_nl": 0.0,                  // Elevation of ground level [meters above mean sea level]
      "l_soil_veg": false,                      // Enable the soil/vegetation surface model.
      "sfctype": 1,                             // Surface scheme for cases without specified surface fluxes.
                                                // 0: fixed sens_ht and latent_ht; 1: ocean bulk formula using t_sfc_nl.
                                                // Convert case specifications in W/m^2 to fixed flux units with
                                                // latent_ht = lhflx / (rho_sfc_flux * Lv) [(m/s) * (kg/kg)] and
                                                // sens_ht = shflx / (rho_sfc_flux * Cp) [(m/s) * K].

      //================================= Restart/Input_Fields =================================
      "l_input_fields": false,                  // Enable replacing fields from the setfields dataset.
      "l_restart": false,                       // Flag for whether this is a restart run.
      "time_restart": 0.0,                      // Time of model restart.
                                                // [seconds since start time listed in netCDF file]

      //================================= Probably should be flags/params =================================
      "l_calc_w_corr": false,                   // Calculate vertical-velocity/hydrometeor correlations.
      "l_diagnose_correlations": false,         // Diagnose probability density function (PDF) correlations.
      "l_uv_nudge": false,                      // Nudge horizontal winds toward the prescribed profiles.
      "l_rtm_nudge": false,                     // Nudge total water toward its prescribed profile.
      "ts_nudge": 7200.0,                       // Nudging timescale [s]
      "rtm_nudge_max_altitude": 1200.0,         // Highest altitude for moisture nudging [m]
      "p_sfc_nl": 101780.0,                     // Pressure at model base              [Pa]
      "fcor_nl": 0.0,                           // Coriolis parameter                  [s^-1]
      "t0": 300.0,                              // Reference temperature (usually 300) [K]

      //================================= Standalone Flags =================================
      "l_t_dependent": false,                   // Read *_sfc.in and, unless ignored, *_forcings.in.
      "l_ignore_forcings": false,               // Skip forcing-file input when l_t_dependent is true.
      "l_input_xpwp_sfc": false,                // Read the surface momentum fluxes upwp_sfc/vpwp_sfc.
      "l_modify_ic_with_cubic_int": false,      // Interpolate the initial sounding cubically.
      "l_modify_bc_for_cnvg_test": false,       // Use convergence-test boundary conditions.
      "l_readiopdata": false,                   // Read the special IOP input dataset.

      //================================= Scalar Settings =================================
      "sclr_dim": 0,                            // Total number of scalars that are computed using higher-order closure
                                                // 0 to shut off all scalar computations
                                                // > 0 the specifies the number of columns in <runtype>_sclr_sounding.in
      "iisclr_rt": -1,                          // Location in the array to place a scalar like total water
      "iisclr_thl": -2,                         // Location in the array to place a scalar like thetal
      "sclr_tol_nl": [0.01, 1e-08],             // Tolerances below which we consider scalar to be 0.
      "edsclr_dim": 0,                          // Add scalars that are computed using simple eddy diffusivity
                                                // 0 to shut off all scalar computations
                                                // > 0 the specifies the number of columns in <runtype>_edsclr_sounding.in
      "iiedsclr_rt": -1,                        // Location in the edsclrm array to place total water
      "iiedsclr_thl": -2,                       // Location in the edsclrm array to place a scalar like thetal

      //================================= Sponge Damping =================================
      "thlm_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 86400.0,         // Minimum damping time-scale (at the top) [s]
        "tau_sponge_damp_max": 86400.0,         // Maximum damping time-scale (base of damping layer) [s]
        "sponge_damp_depth": 0.25               // damping depth as a fraction of domain height [-]
      },
      "rtm_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 86400.0,
        "tau_sponge_damp_max": 86400.0,
        "sponge_damp_depth": 0.25
      },
      "uv_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 600.0,
        "tau_sponge_damp_max": 1800.0,
        "sponge_damp_depth": 0.25
      },
      "wp2_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 60.0,
        "tau_sponge_damp_max": 1800.0,
        "sponge_damp_depth": 0.25
      },
      "wp3_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 60.0,
        "tau_sponge_damp_max": 1800.0,
        "sponge_damp_depth": 0.25
      },
      "up2_vp2_sponge_damp_settings": {
        "l_sponge_damping": false,
        "tau_sponge_damp_min": 60.0,
        "tau_sponge_damp_max": 1800.0,
        "sponge_damp_depth": 0.25
      }
    },

    //================================= Stats =================================
    "stats_setting": {
      "l_stats": true,                          // Flag for statistical output.
      "stats_tsamp": 60.0,                      // Frequency of statistical sampling [s]
                                                // For most complete sampling, let
                                                // stats_tsamp = dt_main
                                                // (stats_tsamp must multiply evenly into stats_tout)
      "stats_tout": 60.0                        // Frequency of statistical output.  [s]
    },

    //================================= GFDL (soon to be removed) =================================
    "gfdl_activation_setting": {},

    //================================= Microphysics =================================
    "microphysics_setting": {
      // Select a scheme explicitly in the case; the options below stay defined.
      "microphys_scheme": "none",               // "morrison", "coamps", "khairoutdinov_kogan", "simplified_ice", "none".
      "microphys_start_time": 0.0,              // Time at which microphysics starts [s]
      "l_ice_microphys": false,                 // Include ice in COAMPS/Morrison.
      "l_graupel": false,                       // Include graupel in COAMPS/Morrison.
      "l_hail": false,                          // Use the Morrison hail option.
      "l_var_covar_src": false,                 // Apply microphysical sources to variances/covariances.
      "l_upwind_diff_sed": false,               // Use upwind sedimentation in KK/COAMPS.

      // Cloud droplets and sedimentation; sigma_g applies to KK/no-microphysics sedimentation.
      "l_cloud_sed": false,                     // Enable cloud-water sedimentation in KK/no microphysics.
      "sigma_g": 1.5,                           // Geometric standard deviation of droplet sizes [-]
      "l_const_nc_in_cloud": false,             // Hold the within-cloud droplet concentration constant.
      "nc0_in_cloud": 1.0e8,                    // Initial cloud-droplet concentration [m^-3]
      "ncnp2_on_ncnm2": 1.0,                    // Within-cloud droplet-number variance / squared mean [-]

      // Morrison options. Subgrid vertical velocity and in-cloud Nc diffusion are
      // scheme settings; they do not enable microphysics when the scheme is "none".
      "l_predict_nc": false,                    // Predict cloud-droplet concentration.
      "l_subgrid_w": true,
      "l_in_cloud_nc_diff": true,
      "l_seifert_beheng": false,
      "l_arctic_nucl": false,
      "l_cloud_edge_activation": false,
      "l_fix_pgam": false,
      "pgam_fixed": 5.0,                        // Fixed cloud-droplet gamma-distribution shape [-]
      "specify_aerosol": "morrison_lognormal",  // Case-specific aerosol distributions stay in presets.

      // Khairoutdinov-Kogan rain formation and evaporation.
      "l_local_kk": false,
      "c_evap": 0.86,                           // Mean geometric radius / mean volume radius [-]
      "r_0": 2.5e-5,                            // Radius assigned to newly formed rain drops [m]

      // PDF hydrometeor variability. For each species, the in-precipitation
      // variance / squared mean is intercept + slope * max(host_dx, host_dy).
      // host_dx and host_dy are horizontal grid spacings [m]. rr/ri/rs/rg name
      // rain/ice/snow/graupel mixing ratios; nr/ni/ns/ng name their concentrations.
      // Intercepts are dimensionless; slopes have units [m^-1]. Common values
      // reduce case overrides; other prescribed values remain with their cases.
      "hmp2_ip_on_hmm2_ip_intrcpt": {
        "rr": 0.54,
        "nr": 0.54,
        "ri": 0.54,
        "ni": 0.54,
        "rs": 0.54,
        "ns": 0.54,
        "rg": 0.54,
        "ng": 0.54
      },
      "hmp2_ip_on_hmm2_ip_slope": {
        "rr": 0.0,
        "nr": 0.0,
        "ri": 2.12e-5,
        "ni": 2.12e-5,
        "rs": 2.12e-5,
        "ns": 2.12e-5,
        "rg": 2.12e-5,
        "ng": 2.12e-5
      },
      "l_fix_w_chi_eta_correlations": true,     // Use prescribed PDF component correlations.

      // SILHS sampling: counts and seed apply only after a case enables sampling.
      "lh_microphys_type": "disabled",          // "interactive", "non-interactive", "disabled".
      "lh_num_samples": 8,
      "lh_sequence_length": 1,                  // Timesteps before reusing the sample sequence
      "lh_seed": 5489,
      "l_silhs_kk_convergence_adj_mean": false  // Adjust the sampled mean for KK convergence tests.
    },

    //================================= Radiation =================================
    "radiation_setting": {
      // Cases select the radiation scheme and whether it contributes to the
      // liquid-water potential-temperature variance (thlp2).
      "rad_scheme": "none",                     // "bugsrad", "simplified", "simplified_bomex", "lba", "none".
      "l_calc_thlp2_rad": false,
      "l_sw_radiation": false,                  // Enable shortwave radiation within the selected scheme.

      // Shared visible direct surface albedo [-].
      "alvdr": 0.07,

      // Simplified radiation: longwave coefficients and the above-cloud correction.
      "f0": 70.0,                               // Cloud-top heating coefficient [W m^-2]
      "f1": 22.0,                               // Cloud-base heating coefficient [W m^-2]
      "kappa": 85.0,                            // Longwave mass absorption coefficient [m^2 kg^-1]
      "l_rad_above_cloud": false,               // Include the DYCOMS-II RF02 above-cloud term.

      // Simplified radiation: shortwave optical properties. Insolation tables
      // and fixed solar-zenith-angle schedules are supplied by the case.
      "eff_drop_radius": 1.0e-5,                // Effective droplet radius [m]
      "gc": 0.86,                               // Asymmetry parameter [-]
      "omega": 0.9965,                          // Single-scattering albedo [-]
      "l_fix_cos_solar_zen": false,

      // BUGSrad: solar input, surface albedos and the atmospheric extension.
      "sol_const": 1321.0,                      // Solar constant [W m^-2]
      "slr": 1.0,                               // Fraction of daylight [-]
      "alvdf": 0.07,                            // Visible diffuse surface albedo [-]
      "alndr": 0.07,                            // Near-IR direct surface albedo [-]
      "alndf": 0.07,                            // Near-IR diffuse surface albedo [-]
      "radiation_top": 30000.0,                 // Top of the extended radiation column [m]
      "l_use_default_std_atmosphere": false     // Extend with the U.S. Standard Atmosphere profile.
    },

    //================================= Input Fields =================================
    "setfields": {
      // Field selections used when l_input_fields or restart is enabled.
      "input_type": "SAM",                      // input_type = "clubb", "coamps_les", or "SAM"
      "l_input_um": true,
      "l_input_vm": true,
      "l_input_rtm": true,
      "l_input_thlm": true,
      "l_input_wp2": true,
      "l_input_wprtp": true,
      "l_input_wpthlp": true,
      "l_input_wp3": true,
      "l_input_rtp2": true,
      "l_input_thlp2": true,
      "l_input_rtpthlp": true,
      "l_input_upwp": true,
      "l_input_vpwp": true,
      "l_input_rcm": true,
      "l_input_em": true,
      "l_input_p": true,
      "l_input_up2": true,
      "l_input_vp2": true
    }
  },

  //================================= CASE PRESETS =================================
  "presets": {

    //================================= arm =================================
    "arm": {                                    // GCSS ARM Cu over land case
      "model_setting": {
        "runtype": "arm",                       // Case name.
        "day": 21,
        "month": 6,
        "year": 1997,
        "lat_vals": 36.62,
        "lon_vals": -97.5,
        "time_initial": 41400.0,
        "time_final": 93600.0,
        "nzmax": 110,
        "deltaz_nl": 40.0,
        "zm_top_nl": 5350.0,
        "p_sfc_nl": 97000.0,
        "fcor_nl": 8.5e-05,
        "restart_path_case": "restart/arm",     // Path from ../run_scripts/.
        "l_t_dependent": true
      },
      "stats_setting": {
        "fname_prefix": "arm"                   // Prefix of output filename.
      },
      "setfields": {
        "datafile": "../les_and_clubb_benchmark_runs/sam_benchmark_runs/JULY_2017/ARM_96x96x110/GCSSARM_96x96x110_67m_40m_1s.nc"
      }
    },

    //================================= arm_0003 =================================
    "arm_0003": {                               // GCSS ARM 0003 deep convective case
      "model_setting": {
        "runtype": "arm_0003",
        "day": 1,
        "month": 3,
        "year": 2000,
        "lat_vals": 36.5,
        "lon_vals": -97.5,
        "time_initial": 63003.0,
        "time_final": 1931404.0,                // time_final = 322202.0   ! Model end time [seconds since midnight on start date]
        "grid_type": 2,
        "deltaz_nl": 200.0,
        "zm_top_nl": 21400.0,
        "zt_grid_fname": "../input/grid/deep_convection_128lev_27km_zt_grid.grd",
        "p_sfc_nl": 97890.0,
        "fcor_nl": 8.697e-05,
        "forcings_file_path": "../input/case_data/arm_0003_forcings/",
        "l_uv_nudge": true,                     // Flag for horizontal wind speed nudging.
        "restart_path_case": "restart/arm_0003",
        "l_t_dependent": true
      },
      "microphysics_setting": {
        "microphys_scheme": "coamps",
        "l_ice_microphys": true,
        "hmp2_ip_on_hmm2_ip_slope": {"rr": 2.12e-05, "nr": 2.12e-05}
      },
      "radiation_setting": {
        "l_calc_thlp2_rad": true
      },
      "stats_setting": {
        "fname_prefix": "arm_0003_clip"
      }
    },

    //================================= arm_3year =================================
    "arm_3year": {                              // GCSS ARM 3 year deep convective case
      "model_setting": {
        "runtype": "arm_3year",
        "day": 1,
        "month": 1,
        "year": 2001,
        "lat_vals": 36.5,
        "lon_vals": -97.5,
        "time_initial": 0.0,
        "time_final": 94690790.0,
        "deltaz_nl": 200.0,
        "zm_top_nl": 25400.0,
        "p_sfc_nl": 98552.44,
        "fcor_nl": 8.697e-05,
        "forcings_file_path": "../input/case_data/arm_3year_forcings/",
        "l_uv_nudge": true,
        "restart_path_case": "restart/arm_3year",
        "l_t_dependent": true
      },
      "microphysics_setting": {
        "microphys_scheme": "morrison",
        "l_ice_microphys": true,
        "hmp2_ip_on_hmm2_ip_slope": {"rr": 2.12e-05, "nr": 2.12e-05}
      },
      "stats_setting": {
        "fname_prefix": "arm_3year",
        "stats_tout": 3600.0
      }
    },

    //================================= arm_97 =================================
    "arm_97": {                                 // ARM IOP Case A: 26-30 June 1997
      "model_setting": {
        "runtype": "arm_97",
        "day": 26,
        "month": 6,
        "year": 1997,
        "lat_vals": 36.5,
        "lon_vals": -97.5,
        "time_initial": 84660.0,
        "time_final": 419460.0,
        "grid_type": 2,
        "deltaz_nl": 150.0,
        "zm_top_nl": 27625.0,
        "zt_grid_fname": "../input/grid/deep_convection_128lev_27km_zt_grid.grd",
        "dt_rad": 1800.0,
        "p_sfc_nl": 97151.03,
        "l_uv_nudge": true,
        "restart_path_case": "restart/arm_97",
        "edsclr_dim": 2,
        "iiedsclr_rt": 1,
        "iiedsclr_thl": 2,
        "sfctype": 0,
        "l_t_dependent": true
      },
      "microphysics_setting": {
        "microphys_scheme": "morrison",
        "l_ice_microphys": true,
        "l_graupel": true,
        "l_const_nc_in_cloud": true,
        "l_var_covar_src": true,
        "lh_microphys_type": "interactive",
        "hmp2_ip_on_hmm2_ip_intrcpt": {"rr": 5.0, "nr": 2.5, "ri": 1.25, "ni": 0.625, "rs": 1.25, "ns": 0.625, "rg": 1.25, "ng": 0.625},
        "ncnp2_on_ncnm2": 0.003,
        "hmp2_ip_on_hmm2_ip_slope": {"ri": 0.0, "ni": 0.0, "rs": 0.0, "ns": 0.0, "rg": 0.0, "ng": 0.0}
      },
      "radiation_setting": {
        "rad_scheme": "bugsrad",
        "l_sw_radiation": true,
        "l_calc_thlp2_rad": true,
        "alvdr": 0.1,
        "sol_const": 1367.0,
        "alvdf": 0.1,
        "alndr": 0.1,
        "alndf": 0.1,
        "radiation_top": 50000.0,
        "l_use_default_std_atmosphere": true
      },
      "stats_setting": {
        "fname_prefix": "arm_97"
      },
      "setfields": {
        "datafile": "../les_and_clubb_benchmark_runs/sam_benchmark_runs/ARM97_r1315_128x128x128_1km_Morrison/ARM9707.nc",
        "input_type": "sam"
      }
    },

    //================================= astex_a209 =================================
    "astex_a209": {                             // ASTEX intermediate regime
      "model_setting": {
        "runtype": "astex_a209",
        "day": 13,
        "month": 6,
        "year": 1992,
        "lat_vals": 34.0,
        "lon_vals": -25.0,
        "time_initial": 0.0,
        "time_final": 144000.0,
        "grid_type": 2,
        "deltaz_nl": 20.0,
        "zm_top_nl": 9000.0,
        "zt_grid_fname": "../input/grid/deep_convection_128lev_27km_zt_grid.grd",
        "p_sfc_nl": 102900.0,
        "fcor_nl": 8.1553388e-05,
        "l_uv_nudge": true,
        "thlm_sponge_damp_settings": {
          "tau_sponge_damp_min": 1800.0
        },
        "rtm_sponge_damp_settings": {
          "tau_sponge_damp_min": 1800.0
        },
        "uv_sponge_damp_settings": {
          "tau_sponge_damp_min": 1800.0
        },
        "restart_path_case": "restart/astex_a209",
        "sclr_tol_nl": 1e-08,
        "l_t_dependent": true,
        "ts_nudge": 86400.0
      },
      "microphysics_setting": {
        "microphys_scheme": "khairoutdinov_kogan",
        "hmp2_ip_on_hmm2_ip_intrcpt": {"rr": 1.0, "nr": 1.0},
        "ncnp2_on_ncnm2": 2.2,
        "c_evap": 0.5,
        "r_0": 0.0001,
        "l_cloud_sed": true,                    // Flag for cloud water sedimentation.
        "sigma_g": 1.2,                         // This parameter is only used with l_cloud_sed = .true.
        "l_var_covar_src": true
      },
      "radiation_setting": {
        "rad_scheme": "bugsrad",
        "l_sw_radiation": true,
        "sol_const": 1376.0,                    // Solar Constant given in spec [W/m^2]
        "l_calc_thlp2_rad": true,
        "l_use_default_std_atmosphere": true
      },
      "stats_setting": {
        "fname_prefix": "astex_a209",
        "stats_tout": 300.0
      }
    },

    //================================= atex =================================
    "atex": {                                   // ATEX intermediate regime
      "model_setting": {
        "runtype": "atex",
        "day": 7,
        "month": 2,
        "year": 1969,
        "lat_vals": 14.9406,
        "lon_vals": -35.0,
        "time_initial": 0.0,
        "time_final": 28800.0,
        "nzmax": 150,
        "deltaz_nl": 20.0,
        "zm_top_nl": 3960.0,
        "l_ignore_forcings": true,              // Do not read values from _forcings.in file, even if l_t_dependent = .true.
        "p_sfc_nl": 101500.0,
        "fcor_nl": 3.75e-05,
        "restart_path_case": "restart/atex",
        "l_t_dependent": true
      },
      "radiation_setting": {
        "rad_scheme": "simplified",
        "f0": 74.0,                             // Coefficient for cloud top heating (see Stevens) [W/m^2]
        "f1": 0.0,                              // Coefficient for cloud base heating (see Stevens) [W/m^2]
        "kappa": 130.0,                         // A constant (Duynkerke eqn. 5)                   [m^2/kg]
        "l_calc_thlp2_rad": true
      },
      "stats_setting": {
        "fname_prefix": "atex"
      },
