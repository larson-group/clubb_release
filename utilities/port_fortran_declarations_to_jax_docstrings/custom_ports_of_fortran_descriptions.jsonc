  "pdf_closure_module": {
    "calc_w_up_in_cloud": {
      "append": "The caller only invokes this function for supported PDF types."
    },
    "compute_cloud_cover": {
      "append": "The Fortran routine has an unreachable fatal-error branch for invalid\ncondition coverage; the JAX function expresses the same reachable cases\nwith masks and leaves values outside them unchanged."
    },
    "trapezoidal_rule_zt": {
      "drop": [
        "The argument variables in the last 5 lines of the subroutine",
        "(wprtp2_zm through pdf_params_zm) are declared intent(inout) because",
        "if l_call_pdf_closure_twice is true, these variables will already have",
        "values from pdf_closure on momentum levels and will not be altered in",
        "this subroutine.  However, if l_call_pdf_closure_twice is false, these",
        "variables will not have values yet and will be interpolated to",
        "momentum levels in this subroutine.",
        "Note:"
      ],
      "append": "When l_call_pdf_closure_twice is true, the momentum-level arguments\n(wprtp2_zm through pdf_params_zm) already hold the values from pdf_closure\non momentum levels and are not altered; otherwise they are interpolated to\nmomentum levels here."
    }
  },
  "saturation": {
    "sat_vapor_press_liq_gfdl": {
      "append": "This function is shared with sat_mixrat_liq; it keeps the lower\ntemperature bound used in the Fortran sat_mixrat_liq_* GFDL branch."
    }
  },
  "setup_clubb_pdf_params": {
    "denorm_transform_corr": {
      "append": "As in Fortran, the component-2 transforms involving Ncn reuse the\ncomponent-1 Ncn variance ratio sigma2_on_mu2_ip_1[Ncn]; Ncn is inherently\nin-cloud, so its ratio is shared across components."
    },
    "norm_transform_mean_stdev": {
      "append": "Where the in-precip. mean is below tolerance, Fortran sets the normal-space\nmean to -huge as an \"absent\" marker; the JAX function uses a finite floor\n(mean_L2N of |mu| floored to 1e-30), which keeps the vanishing weight in\nthe integrals that use it while leaving gradients finite."
    },
    "pack_hydromet_pdf_params": {
      "append": "Fortran packs an (ngrdcol, nzt) array of derived types; the JAX object\nstores those per-cell fields as leading array dimensions on each field of\none HydrometPdfParameter pytree."
    }
  },
  "sponge_layer_damping": {
