// Adaptations of the Fortran Description and References text written into
// the JAX docstrings by port_fortran_declarations_to_jax_docstrings.py
// -write_description. Functions without an entry get the Fortran text
// unchanged. Keys are {JAX module: {function: edit}}; see README.md for the
// edit keys. Comments are allowed.
{
  "adg1_adg2_3d_luhar_pdf": {
    "backsolve_Luhar_params": {
      "append": "Only the cubic-formula branch is ported: in Fortran,\nl_use_cubic_backsolve is a parameter set to .true., so the quadratic\napproximation is never used."
    }
  },
  "advance_helper_module": {
    "compute_Cx_fnc_Richardson": {
      "append": "The Fortran routine also contains a disabled path that vertically averages\nCx_fnc_Richardson over a distance of Lscale. Its flag is a compile-time\n.false. parameter there, so only the active path is ported; Lscale_zm and\nrho_ds_zm, used only by that path, are accepted for parity with Fortran."
    },
    "set_boundary_conditions_lhs": {
      "replace": [
        [
          "left-hand side LAPACK matrix",
          "left-hand side matrix"
        ]
      ],
      "append": "The Fortran level indices are 1-based; they are converted to 0-based\nindices before lhs is updated."
    },
    "smooth_max": {
      "replace": [
        [
          "For more details, see the interface in this file.",
          "This single JAX function covers all Fortran versions of the smooth_max\ninterface (array and scalar inputs broadcast); the declarations below\nare those of smooth_max_arrays."
