      ]
    },
    "smooth_min": {
      "replace": [
        [
          "For more details, see the interface in this file.",
          "This single JAX function covers all Fortran versions of the smooth_min\ninterface (array and scalar inputs broadcast); the declarations below\nare those of smooth_min_arrays."
