  "mixing_length": {
    "compute_coherent_mixing_length": {
      "append": "JAX adaptation:\n  Fixed-length scans and masks include the first layer at mean coherence\n  <= 0.01, then freeze that launch, even within a partially active block.\n  Each carry holds parcel thl/rt, previous buoyancy/work/barrier, live masks,\n  raw travel distances, crossing/arrival sums, and a group-activity flag.\n  CPU batches of at least five columns default to eight-launch groups for\n  forward speed; smaller batches and GPUs evaluate all launches together.\n  The COHERENT_* module constants set this layout.\n\n  Grouped scans skip inactive layers and blocks. Ungrouped scans check only\n  block boundaries to avoid per-layer synchronization. Forward working state\n  is O(columns*levels); checkpoints trade recomputation for a smaller reverse\n  tape. CPU aggregation follows the source recurrence; GPU prefix sums and\n  launch grouping change floating-point addition order."
    },
    "compute_mixing_length": {
      "drop": [
        "IMPORTANT NOTE:",
        "This subroutine has been optimized",
        "equations to avoid divides",
        "-Gunther Huebler",
        "The algorithm previously used looped",
        "a parcel up from its initial grid level",
        "algorithm is an N^2"
      ],
      "append": "JAX adaptation:\n  Fixed-length scans advance independent column/launch pairs by a common\n  offset in grid levels. Masks retain the first energy-exhaustion result;\n  scalar conditionals skip inactive work without changing scan length.\n  Each carry holds parcel properties, remaining TKE, previous buoyancy,\n  live/exit masks, and the level/energy/buoyancy data for the stopping root.\n  Prefix extrema replace serial endpoint coupling. Forward working state is\n  O(columns*levels); no launch-by-target trajectory matrix is returned.\n  Checkpoints recompute layer intermediates during reverse differentiation.\n  Blocks of eight offsets skip inactive tails. CPU batches above four columns\n  use groups of four launches; accelerators evaluate all launches together."
    },
    "sat_mixrat_liq_flatau": {
      "drop": [
        "so the compiler can inline it into parcel trajectories.",
        "It is also intentionally the serial method as opposed to the",
        "complex pipeline / multi-fma unit friendlier version. This was",
        "to minimize register usage in the complex loop it is used in."
      ],
      "replace": [
        [
          "This compact specialization is colocated with the mixing-length closure",
          "This compact specialization is colocated with the mixing-length closure."
        ],
        [
          "See saturation.F90 for more details.",
          "See saturation.py for more details."
        ],
        [
          "are scalar inputs;",
          "broadcast as arrays;"
        ],
        [
          "saturation.F90: shared saturation",
          "saturation.py: shared saturation"
        ]
      ],
      "append": "Inactive division operands are guarded so that reverse-mode derivatives\nstay finite."
    }
  },
  "mono_flux_limiter": {
    "calc_mean_w_up_down_component": {
      "drop": [
        "Notes: The calculation has been updated to optionally use intel's",
        "mkl_vml functions to allow vectorized calculations. Not all",
        "grid levels require expensive calculations though, so the",
        "strategy is as follows",
        "1. Keep track of which levels",
        "2. Store those the relavent values",
        "a contigous array",
        "3. Perform vectorized calculation",
        "using mkl_vml functions",
        "4. Unpack results",
        "Enabling this faster version requires",
        "using -DMKL as a compiler flag"
      ],
      "append": "The Fortran routine has an optional MKL vectorized path; the JAX function\nuses array expressions directly and needs no MKL packing and unpacking."
    },
    "calc_turb_adv_range": {
      "append": "Fortran keeps both grid-direction loops inside this routine; the JAX\nfunction delegates them to private helpers so that the lax.while_loop\ncarries stay small and static."
    },
    "monotonic_turbulent_flux_limit": {
      "replace": [
        [
          "gr%nzm",
          "gr.nzm"
        ]
      ],
      "append": "The vertical scan over levels uses jax.lax.scan."
    }
  },
  "new_hybrid_pdf": {
    "calculate_coef_wp4_implicit": {
      "append": "Fortran repeats the full calculate_coef_wp4_implicit body in this module;\nthe JAX function delegates to the shared formula in new_pdf.py instead of\nkeeping a second copy of the same algebra."
    },
    "calculate_mixture_fraction": {
      "append": "Fortran keeps this as a separate elemental function; the JAX function\ncalls the shared new_pdf mixture-fraction function with sgn_wpxp = +1,\nbecause w is the setting variable."
    }
  },
  "new_pdf": {
    "sort_roots": {
      "append": "The Fortran routine sorts the three roots with an explicit sorting\nnetwork; jnp.sort performs the same operation on the returned values."
    }
