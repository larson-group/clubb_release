  "code_timer_module": {
    "timer_finalize": {
      "append": "JAX adaptations: state supplies outstanding arrays for trace completion,\nand the function returns the exported capture directory, or None when no\ncapture was made. Basic timing does not wait for arrays, and neither\nbackend synchronizes individual timer regions. The caller owns\npresentation of the capture."
    },
    "timer_start": {
      "append": "step_num is optional JAX profiling metadata identifying a model timestep.\nOrdinary timer calls keep the one-name interface of the Fortran routine."
    }
  },
  "corr_varnce_module": {
    "init_pdf_hydromet_arrays_api": {
      "append": "The subgrid variance ratio for each hydrometeor is calculated from the grid\nspacing defined by the host model, by a linear equation with a slope and an\nintercept. When the slope or intercept is not passed in, the default value\nfrom the corresponding type definition is used. For full control over the\nhydrometeor variance ratios, pass in slopes of 0.0, so that the ratios no\nlonger depend on the grid spacing, and intercepts set to the desired ratios."
    }
  },
  "diagnose_correlations_module": {
    "corr_array_assertion_checks": {
      "append": "The Fortran routine stops the program on failure; the JAX function returns\nFalse instead."
    }
  },
  "diffusion": {
    "diffusion_zm_lhs": {
      "append": "The Fortran out-argument lhs is returned as an array with diagonal order\n[superdiagonal, main diagonal, subdiagonal]; Fortran 1-based grid indices\nare represented by 0-based Python slices."
    },
    "diffusion_zt_lhs": {
      "append": "The Fortran out-argument lhs is returned as an array with diagonal order\n[superdiagonal, main diagonal, subdiagonal]; Fortran 1-based grid indices\nare represented by 0-based Python slices."
